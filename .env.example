# IntelliSupply — copy to .env and fill in values (never commit .env)

# ── Seeded Supabase login accounts (after aura_reseed / profile sync) ────────
# admin@intellisupply.com / admin123
# courier1@intellisupply.com / courier123
# logistics1@intellisupply.com / logistics123
# inventory1@intellisupply.com / inventory123
# Frontend demo fallback (offline only): admin@demo.com / admin

# ── Auth (Google OAuth + sessions) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FASTAPI_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=false

# ── Inventory Postgres (NL-to-SQL) ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Neo4j (local dev) ────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=intellisupply
NEO4J_USE_LOCAL=false

# ── Neo4j Aura (production graph) ────────────────────────────────────────────
NEO4J_AURA_URI=neo4j+ssc://YOUR_INSTANCE.databases.neo4j.io
NEO4J_AURA_USER=your_aura_user
NEO4J_AURA_PASSWORD=your_aura_password
NEO4J_AURA_DATABASE=neo4j

# ── Supabase (one-time graph load from logistics tables) ─────────────────────
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_password

# ── LLM (NVIDIA NIM — agents + GraphRAG + NL-to-SQL) ─────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key
GRAPH_LLM_MODEL=meta/llama-3.1-8b-instruct

# ── ML model overrides ───────────────────────────────────────────────────────
# ROUTE_RANKER_MODEL=notebooks/route_prediction/route_ranker.pkl
# DEMAND_MODEL=lade_demand_forecaster.pkl
# LADE_DATA_DIR=

# ── Hugging Face (demand inference via HF Space) ─────────────────────────────
# HF_TOKEN=
# HF_DEMAND_FORECAST_URL=https://your-space.hf.space

# ── Agent CLI identity (optional) ────────────────────────────────────────────
# INTELLISUPPLY_USER_ROLE=LOGISTICS
# INTELLISUPPLY_COURIER_ID=
